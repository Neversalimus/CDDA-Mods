{
  "schema": 1,
  "automatic": {
    "enabled": false,
    "scope": "smoke",
    "schedule_note": "Scheduled deep runtime is intentionally disabled by default. workflow_dispatch always remains available."
  },
  "default_target": "experimental-2026-09-23-0546",
  "official_binary": {
    "asset_regex": "^cdda-linux-terminal-only-x64-.*\\.tar\\.gz$",
    "timeout_seconds": 900
  },
  "source_runtime": {
    "components": [
      "axiom_7",
      "blazemod",
      "secronom",
      "secronom_plus",
      "aftershock_prime",
      "tankmod"
    ],
    "profiles": {
      "secronom-stack": [
        "secronom_plus"
      ],
      "all-json": [
        "axiom_7",
        "blazemod",
        "secronom_plus",
        "aftershock_prime",
        "tankmod"
      ]
    },
    "selectors": {
      "smoke": [
        "[force_load_game]"
      ],
      "deep": [
        "[force_load_game]",
        "~[slow] ~[.],starting_items"
      ],
      "exhaustive": [
        "[force_load_game]",
        "~[slow] ~[.],starting_items",
        "[slow] ~starting_items"
      ]
    },
    "per_selector_timeout_seconds": 10800,
    "max_parallel_cases": 3
  }
}
