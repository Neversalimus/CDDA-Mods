  {
    "id": "MISSION_AXIOM_KX91_DIAGNOSTIC",
    "type": "mission_definition",
    "name": {
      "str": "KX-91: cold diagnostic"
    },
    "description": "Use Nadia's service probe on the KX-91 flight deck and return with a clean diagnostic handshake.",
    "goal": "MGOAL_CONDITION",
    "goal_condition": {
      "compare_string": [
        "yes",
        {
          "u_val": "axiom_kx91_diag_scan"
        }
      ]
    },
    "difficulty": 3,
    "value": 0,
    "has_generic_rewards": false,
    "start": {
      "effect": [
        {
          "u_add_var": "axiom_kx91_service_authorized",
          "value": "yes"
        },
        {
          "u_add_var": "axiom_kx91_project_started",
          "value": "yes"
        },
        {
          "u_spawn_item": "axiom_kx91_diag_probe",
          "suppress_message": true
        }
      ],
      "update_mapgen": {
        "om_terrain": "axiom_7_roof_s",
        "om_special": "axiom_7_facility_v06",
        "remove_vehicles": [
          {
            "vehicles": [
              "axiom_kx91_dormant",
              "axiom_kx91_powered",
              "axiom_kx91_avionics",
              "axiom_kx91_weapons_ready",
              "axiom_combat_helicopter"
            ],
            "x": [
              0,
              23
            ],
            "y": [
              0,
              23
            ]
          }
        ],
        "place_vehicles": [
          {
            "vehicle": "axiom_kx91_dormant",
            "x": 13,
            "y": 12,
            "rotation": 0,
            "fuel": 0,
            "status": 2,
            "faction": "axiom_7"
          }
        ]
      }
    },
    "end": {
      "effect": [
        {
          "u_add_var": "axiom_kx91_stage_diag",
          "value": "yes"
        },
        {
          "u_add_var": "axiom_kx91_service_authorized",
          "value": "no"
        },
        {
          "u_consume_item": "axiom_kx91_diag_probe",
          "count": 1,
          "popup": false
        }
      ]
    },
    "origins": [
      "ORIGIN_SECONDARY"
    ],
    "dialogue": {
      "describe": "Wake KX-91 on the maintenance bus and collect a real fault picture.",
      "offer": "I am done guessing from dead indicators. Take this service probe to the aircraft, stand on the flight deck, and run a maintenance handshake. It cannot grant flight control; it only wakes the diagnostic bus long enough to tell us what is actually broken.",
      "accepted": "Good. The deck will treat you as service-authorized while the project is active. Do not improvise with the controls.",
      "rejected": "Then KX-91 can continue being an extremely expensive roof ornament.",
      "advice": "Use the probe on the KX-91 section of the flight deck. If you are not on the correct overmap tile, it will refuse the handshake.",
      "inquire": "Did you get a clean maintenance handshake?",
      "success": "Seven primary faults. Better than I expected, worse than I hoped. Most importantly, the airframe bus is coherent. KX-91 is repairable.",
      "success_lie": "The probe records its own handshake. If it did not run, I know.",
      "failure": "Then we go back to treating the aircraft as a sealed unknown."
    },
    "fail": {
      "effect": [
        {
          "u_add_var": "axiom_kx91_service_authorized",
          "value": "no"
        },
        {
          "u_add_var": "axiom_kx91_operator_authorized",
          "value": "no"
        }
      ]
    }
  },
  {
    "id": "MISSION_AXIOM_KX91_POWER",
    "type": "mission_definition",
    "name": {
      "str": "KX-91: power spine"
    },
    "description": "Recover a high-load regulator from a surviving electrical substation and return it to Elias Chen.",
    "goal": "MGOAL_FIND_ITEM",
    "difficulty": 4,
    "value": 0,
