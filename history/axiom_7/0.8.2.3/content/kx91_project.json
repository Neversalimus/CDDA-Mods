          "u_message": "AXIOM maintenance replaces the failed KX-91 regulator. Main storage batteries and the protected service bus are brought online.",
          "type": "good"
        },
        {
          "update_mapgen": {
            "om_terrain": "axiom_7_roof_s",
            "om_special": "axiom_7_facility_v06",
            "remove_vehicles": [
              {
                "vehicles": [
                  "axiom_kx91_dormant",
                  "axiom_kx91_powered",
                  "axiom_kx91_avionics",
                  "axiom_kx91_weapons_ready",
                  "axiom_combat_helicopter"
                ],
                "x": [
                  0,
                  23
                ],
                "y": [
                  0,
                  23
                ]
              }
            ],
            "place_vehicles": [
              {
                "vehicle": "axiom_kx91_powered",
                "x": 13,
                "y": 12,
                "rotation": 0,
                "fuel": 0,
                "status": 2,
                "faction": "axiom_7"
              }
            ]
          }
        }
      ]
    },
    "origins": [
      "ORIGIN_SECONDARY"
    ],
    "dialogue": {
      "describe": "KX-91 needs a replacement regulator before we can energize the main distribution spine.",
      "offer": "The aircraft did not lose its batteries first. It lost the regulator that decides how brutally they are allowed to feed the rest of the machine. A compatible industrial unit should still be sitting in one of the substations we surveyed. Bring me the regulator, not the whole cabinet.",
      "accepted": "Substation marked. The regulator is a hardened module, roughly the size of a car battery, with ceramic bus lugs on both ends.",
      "rejected": "Then I keep the aircraft on the safe bus and nothing expensive catches fire.",
      "advice": "The substation floor is the target. Do not waste time stripping transformers; I need the control-side regulator.",
      "inquire": "Do you have the high-load regulator?",
      "success": "Good. Give me the afternoon. The main bus will wake in sections, not all at once. If you hear Nadia swearing, that means the test is proceeding normally.",
      "success_lie": "That is not the regulator. It is heavy and electrical, which is not the same thing.",
      "failure": "Then the KX stays on auxiliary power until we find another donor."
    }
  },
