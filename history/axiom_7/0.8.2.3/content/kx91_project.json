    "origins": [
      "ORIGIN_SECONDARY"
    ],
    "dialogue": {
      "describe": "Viktor needs a clean reference set before he will trust KX-91 navigation again.",
      "offer": "The inertial unit can be calibrated now, but calibration without reference data only gives you a very precise way to be wrong. One of our old radio sites kept a hardened navigation archive for field aircraft. Recover it and I can rebuild the correlation tables.",
      "accepted": "Radio site marked. Look near the control electronics, not the mast itself.",
      "rejected": "Then Nadia keeps a map on her clipboard and the aircraft keeps pretending that counts as navigation.",
      "advice": "The archive is a sealed processor module. Water damage outside the casing is acceptable; impact damage is not.",
      "inquire": "Did the navigation archive survive?",
      "success": "It did. Good. I can reconcile the inertial drift against known reference sets instead of inventing corrections from scratch.",
      "success_lie": "No. This is not a navigation reference package.",
      "failure": "Then the flight computer remains blind in a very sophisticated way."
    }
