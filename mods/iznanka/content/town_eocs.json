  {
    "type": "effect_on_condition",
    "id": "IZN_RADIO",
    "eoc_type": "ACTIVATION",
    "effect": [
      {
        "math": [
          "izn_radio_done = 1"
        ]
      },
      {
        "u_run_monster_eocs": [
          "IZN_SILENCE_VOICE"
        ],
        "mtype_ids": [
          "mon_izn_voice"
        ],
        "monster_range": 24
      },
      {
        "u_transform_radius": 2,
        "ter_furn_transform": "izn_radio_activate"
      },
      {
        "math": [
          "u_izn_resonance = 0"
        ]
      },
      {
        "u_spawn_item": "izn_suppressor",
        "count": 1
      },
      {
        "u_spawn_item": "izn_radio_manual",
        "count": 1
      },
      {
        "u_spawn_item": "izn_seal",
        "count": 2
      },
      {
        "run_eocs": "IZN_LEARN_SUPPRESSOR"
      },
      {
        "u_message": "Хор замолкает.  Радиоузел согласован: второй маршрут завершён.  В шкафу вы находите подавитель, руководство и две печати."
      }
    ],
    "condition": {
      "and": [
        {
          "current_dimension": "iznanka"
        },
        {
          "math": [
            "izn_radio_done == 0"
          ]
        },
        {
          "or": [
            {
              "math": [
                "izn_voices_dead >= 3"
              ]
            },
            {
              "math": [
                "izn_tuned_a + izn_tuned_b + izn_tuned_c >= 3"
              ]
            }
          ]
        }
      ]
    },
    "false_effect": [
      {
        "u_message": "Радиоузел удерживает Хор.  Настройте все три пульта либо уничтожьте три голоса.  Награда не повторяется."
      }
    ]
  },
