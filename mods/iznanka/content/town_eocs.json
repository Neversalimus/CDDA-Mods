[
  {
    "type": "effect_on_condition",
    "id": "IZN_DISCOVER_TOWN",
    "eoc_type": "ACTIVATION",
    "effect": [
      {
        "math": [
          "izn_tuned_a = max(0, izn_tuned_a)"
        ]
      },
      {
        "math": [
          "izn_tuned_b = max(0, izn_tuned_b)"
        ]
      },
      {
        "math": [
          "izn_tuned_c = max(0, izn_tuned_c)"
        ]
      },
      {
        "math": [
          "izn_voices_dead = max(0, izn_voices_dead)"
        ]
      },
      {
        "math": [
          "izn_radio_done = max(0, izn_radio_done)"
        ]
      },
      {
        "math": [
          "izn_node_done = max(0, izn_node_done)"
        ]
      },
      {
        "math": [
          "u_izn_resonance = max(0, u_izn_resonance)"
        ]
      },
      {
        "if": {
          "math": [
            "!has_var(izn_town)"
          ]
        },
        "then": [
          {
            "u_location_variable": {
              "global_val": "izn_town"
            },
            "target_params": {
              "om_terrain": "izn_town_gate",
              "om_special": "izn_town",
              "search_range": 60,
              "z": 0,
              "random": true
            },
            "false_eocs": [
              {
                "id": "IZN_TOWN_SEARCH_FAILED",
                "effect": [
                  {
                    "u_message": "Посёлок пока не удалось найти.  Попробуйте детектор с другого края исследованной области."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": {
          "math": [
            "has_var(izn_town)"
          ]
        },
        "then": [
          {
            "reveal_map": {
              "global_val": "izn_town"
            },
            "radius": 3
          }
        ]
      }
    ],
    "condition": {
      "current_dimension": "iznanka"
    }
  },
  {
