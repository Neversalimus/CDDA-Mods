          "math": [
            "u_skill('electronics') >= 2"
          ]
        }
      ]
    },
    "false_effect": [
      {
        "u_message": "Нужна электроника 2; настроенный канал повторно не обрабатывается.  Можно вместо этого уничтожить три голоса Хора."
