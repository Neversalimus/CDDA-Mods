  {
    "type": "effect_on_condition",
    "id": "IZN_TUNE_A_BEGIN",
    "eoc_type": "ACTIVATION",
    "effect": [
      {
        "u_location_variable": {
          "u_val": "izn_console"
        },
        "furniture": "f_izn_tuner_a",
        "target_max_radius": 2,
        "true_eocs": [
          "IZN_TUNE_A_START"
        ]
      }
    ],
    "condition": {
      "and": [
        {
          "current_dimension": "iznanka"
        },
        {
          "math": [
            "izn_tuned_a == 0"
          ]
        },
